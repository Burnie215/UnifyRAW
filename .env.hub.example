# Einstellungen eines Sync-Hubs, der allein laeuft (docker-compose.hub.yml).
# Fuer das volle Backend gilt .env.example - das ist die laengere Liste, weil
# dort auch Proxy, Dateien und RAW-Decoder konfiguriert werden. Ein Hub hat
# nichts davon.
#
# VORAUSSETZUNG: Dieser Hub muss aus dem oeffentlichen Internet erreichbar sein
# - oeffentlicher DNS-Name plus Reverse Proxy mit Zertifikat oder ein Tunnel.
# Ein Hub auf einer privaten Adresse (192.168.x, 10.x) ist von einer App auf
# einer oeffentlichen Domain nicht ansprechbar: der Browser verbietet
# public -> private (Private Network Access), und daran aendert weder CORS noch
# ein gueltiges Zertifikat etwas. Wer App und Hub im selben privaten Netz
# behalten will, nimmt das volle Selfhost-Abbild - dort teilen sie sich eine
# Adresse und brauchen weder CORS noch diese Datei.

# Erzeugen mit: openssl rand -hex 32
# Bleibt ueber Neustarts gleich, sonst sind alle ausgegebenen Token ungueltig.
AUTH_SECRET=

# Nur gelesen, solange die Benutzertabelle leer ist. Nach dem ersten
# erfolgreichen Start duerfen beide hier verschwinden; das Konto bleibt in der
# Datenbank. Dieses erste Konto ist Administrator.
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=

# Auf einem Hub ist das eine echte Wahl. Wer sich hier registriert, bekommt
# `role: 'user'` und damit ausschliesslich /api/auth und /api/sync - die
# Datei-, Proxy- und Decoder-Routen gibt es in diesem Abbild nicht.
# Bleibt es false, legt der Administrator Konten an (heute: direkt in der
# Datenbank, eine Verwaltungsoberflaeche gibt es noch nicht).
AUTH_REGISTRATION_ENABLED=false

# PFLICHT. Die exakten Origins der Apps, die diesen Hub nutzen duerfen,
# kommagetrennt. Ohne sie antwortet der Hub ohne CORS-Header und keine App
# kann ihn ansprechen. Wildcards sind nicht erlaubt, Schraegstrich am Ende
# wird abgeschnitten.
#   CORS_ALLOWED_ORIGINS=https://app.unifyraw.com
#   CORS_ALLOWED_ORIGINS=https://app.unifyraw.com,https://fotos.example.org
CORS_ALLOWED_ORIGINS=

# Zahl der Reverse-Proxy-Sprunge vor dem Hub: 1 = Traefik/nginx,
# 2 = Cloudflare-Tunnel plus Traefik, 0 = Clients verbinden direkt.
# TRUST_PROXY=true wird beim Start abgelehnt - es hiesse, der ganzen
# weitergereichten Kette zu glauben, und dann kann jeder Client jede Adresse
# behaupten.
TRUST_PROXY=0
