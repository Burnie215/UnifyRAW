{
  "name": "photolib",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "predev:backend": "npm run build -w @photolib/shared",
    "dev:backend": "AUTH_MODE=disabled npm run dev -w @photolib/backend",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "npm run build -w @photolib/shared && tsc -b && vite build",
    "build:online": "VITE_MODE=online npm run build",
    "build:selfhost": "VITE_MODE=hosted npm run build",
    "build:backend": "npm run build -w @photolib/backend",
    "lint": "eslint .",
    "typecheck": "tsc -b --force",
    "typecheck:tests": "tsc -p tsconfig.test.json && tsc -p packages/backend/tsconfig.test.json",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run test:node",
    "preview": "vite preview",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "i18n:unused": "tsx scripts/i18n-unused.ts",
    "test:responsive": "playwright test -c playwright.responsive.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.5",
    "@capacitor/core": "^7.6.5",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.5",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@photolib/shared": "*",
    "blurhash": "^2.0.5",
    "exifr": "^7.1.3",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "icc": "^4.0.0",
    "libheif-js": "^1.19.8",
    "libraw-wasm": "^1.6.0",
    "onnxruntime-web": "^1.20.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.8",
    "sql.js": "^1.14.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@webgpu/types": "^0.1.69",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.10"
  }
}
