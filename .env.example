# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Used only when the users table is empty. After the first successful startup,
# these may be removed from .env; the account remains in photolib.db.
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=

# Full PhotoLib deployments should keep public registration disabled. A
# dedicated multi-user SYNC_ONLY hub may explicitly enable it.
AUTH_REGISTRATION_ENABLED=false

# Only for docker-compose.yml (the variant with Caddy): the IP address or name
# under which UnifyRAW is reached on your network, e.g. 192.168.1.50. Caddy
# issues its HTTPS certificate for exactly this address. Browsers refuse to run
# the app over plain http:// from another device, so there is no way around it.
# docker-compose.proxy.yml ignores it - there your own proxy does TLS.
UNIFYRAW_HOST=

# Leave empty for same-origin web deployments. Comma-separated exact origins,
# for example https://app.example.com,capacitor://localhost
CORS_ALLOWED_ORIGINS=

# Number of trusted reverse-proxy hops in front of Node: 1 = Traefik/nginx,
# 2 = Cloudflare tunnel + Traefik, 0 = clients connect directly. Behind a proxy
# without it, every client shares the proxy's address and one login limit.
# Express expressions such as "loopback" or a CIDR list are passed through.
# "false", "off" and "no" are the same as 0. TRUST_PROXY=true (also "on",
# "yes") is refused at startup with a message naming the hop count: it would
# mean trusting the entire forwarded chain, so any client could claim any
# address — Express itself rejects the string as "invalid IP address: true".
TRUST_PROXY=0

# Prefer comma-separated exact DNS hostnames for LAN/Docker targets. Schemes,
# ports, wildcards and IP literals are intentionally not accepted.
PROXY_ALLOWED_PRIVATE_HOSTS=
RAW_ALLOWED_PRIVATE_HOSTS=

# Legacy broad private-network switches. Keep these false when the exact host
# allowlists above are sufficient. Loopback, link-local, metadata and reserved
# addresses remain blocked even when a broad switch is enabled.
PROXY_ALLOW_PRIVATE_TARGETS=false
RAW_ALLOW_PRIVATE_FETCH=false

# Request/response limits in MiB and maximum simultaneous/queued RAW decodes.
PROXY_MAX_BODY_MB=100
PROXY_MAX_RESPONSE_MB=256
RAW_MAX_UPLOAD_MB=128
RAW_MAX_REMOTE_MB=256
RAW_DECODE_CONCURRENCY=2
RAW_DECODE_QUEUE_LIMIT=16
